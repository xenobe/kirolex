{
  "name": "kirolex",
  "version": "0.1.0",
  "author": "KiroLex contributors",
  "description": "KiroLex - Desktop chat client powered by kiro-cli ACP",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json && electron . --dev",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win --dir",
    "package:installer": "npm run build && electron-builder --win",
    "start:dev": "electron . --dev",
    "dev:hot": "node scripts/dev-hot.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "package:mac": "npm run build && electron-builder --mac",
    "package:mac:dir": "npm run build && electron-builder --mac --dir",
    "skill:validate": "node scripts/skill-validate.mjs"
  },
  "build": {
    "appId": "com.kirolex.app",
    "productName": "KiroLex",
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "portable": {
      "artifactName": "KiroLex.exe"
    }
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@xyflow/react": "^12.11.3",
    "highlight.js": "^11.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true
  }
}
